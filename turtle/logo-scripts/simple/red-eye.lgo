; Inspired by image at:
; https://ca.pinterest.com/pin/807059195705050791
to redEye :height
	localmake "oldState turtleState
	localmake "whiteWidth :height * 0.74
	jumpForward :height / 2
	setPenSize 0
	setFillColor "red
	circle :height / 2
	localmake "center pos
	jumpLeft :whiteWidth / 2
	right 90
	setFillColor "white
	arcPair :whiteWidth 95
	setPenColor "black
	setPenSize :height * 0.12
	setFillColor transparent
	jumpTo :center
	circle :height * 0.076
	setTurtleState :oldState
end

setScreenColor "black
redEye 100