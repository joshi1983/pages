to maerskStar :radius
	localmake "oldState turtleState

	setFillColor "white
	setPenSize 0
	isotoxalStar :radius :radius * 0.3488372 7

	setTurtleState :oldState
end

; Inspired by flag at:
; https://commons.wikimedia.org/wiki/File:Flag_of_Maersk.png
to maerskFlag :height
	localmake "oldState turtleState
	localmake "width :height * 2
	jumpLeft :width / 2
	jumpForward :height / 2
	right 90
	setFillColor "#09c
	setPenSize 0
	isoTriangle :height :width
	jumpForward :width * 0.246
	left 90
	maerskStar :height * 0.275
	setTurtleState :oldState
end

; Inspired by logo at:
; https://commons.wikimedia.org/wiki/File:Maersk_Group_Logo.svg
; Also, shown at:
; https://www.maersksupplyservice.com/
to maerskLogo :height
	localmake "oldState turtleState
	jumpForward :height / 2
	setPenSize 0
	setFillColor "#42B0D5
	roundRect :height * 0.95 :height :height * 0.11
	maerskStar :height * 0.43
	setTurtleState :oldState
end

make "height 100
make "separation :height * 5
jumpLeft :separation / 2
maerskLogo :height
jumpRight :separation
maerskFlag :height