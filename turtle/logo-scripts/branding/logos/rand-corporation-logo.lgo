to drawUpperLeftArc :height
	localmake "oldState turtleState
	localmake "oldHeading heading
	localmake "outerRadius :height * 0.7

	jumpForward :height
	localmake "top pos
	jumpLeft :height / 2
	localmake "topLeft pos

	jumpTo :top
	jumpForward :height * 0.183
	jumpLeft :height * 0.438
	localmake "center pos
	jumpTo :topLeft
	setHeading :oldHeading + 180
	jumpForward distanceToCircle :center :outerRadius
	localmake "left pos

	setPenSize 0
	setFillColor "white
	setHeading (towards :center) + 90
	polyStart
	arcLeft (getArcLeftAngleToLine :outerRadius :top :topLeft) :outerRadius
	setHeading :oldHeading
	jumpLeft :height * 0.023
	setHeading (towards :center) - 90
	localmake "innerRadius distance :center
	arcRight (getArcRightAngleToLine :innerRadius :left :topLeft) :innerRadius
	polyEnd

	setTurtleState :oldState
end

to drawR :fontHeight
	localmake "oldState turtleState
	localmake "arcs1 [[-25 0.33] [-40 0.18] [-25 0.245]]
	localmake "angle 34.7
	localmake "thickness :fontHeight * 0.1
	jumpForward :fontHeight * 0.01
	localmake "basePos pos
	jumpLeft :fontHeight * 0.263
	localmake "leftPos pos
	setLineJoinStyle "miter
	setLineCap "butt
	setPenSize :thickness
	arcLines [[0.92] [-90 0] [0.21]] :fontHeight
	arcLines combine :arcs1 reverse :arcs1 :fontHeight
	jumpRight penSize / 2
	jumpForward :fontHeight * 0.06
	setPenSize 0
	setFillColor penColor
	left 90
	localmake "height distanceToLine :basePos :leftPos
	parallelogram :thickness / cos :angle :height / cos :angle -:angle
	setTurtleState :oldState
end

to drawA :fontHeight
	localmake "oldState turtleState
	localmake "oldHeading heading
	localmake "thickness :fontHeight * 0.1
	localmake "angle1 66
	localmake "thickness2 :thickness / :fontHeight / sin :angle1
	localmake "midWidth :fontHeight * 0.5
	setPenSize 0
	setFillColor penColor
	right 180
	drawArcLineShape [0 -1
		pathMirror [[0.015] [:angle1 0] [1.08] [180 - :angle1 0]
		[:thickness2] [:angle1 0] [0.84]]
	] :fontHeight
	setHeading :oldHeading
	jumpForward :fontHeight * 0.29
	stripes :midWidth :thickness [penColor]
	setTurtleState :oldState
end

to drawN :fontHeight
	localmake "oldState turtleState
	localmake "oldHeading heading
	localmake "angle1 43.5
	localmake "angle2 90 - :angle1
	jumpForward :fontHeight / 2
	localmake "center pos
	setPenSize 0
	setFillColor penColor
	repeat 2 [
		setHeading :oldHeading + repcount * 180		
		drawArcLineShape [0 0
			[[0.075] [:angle1 0] [0.59] [:angle2 0] [0.03] [90 0] [0.99] [90 0] [0.11] [90 0] [0.755]
			[-:angle2 - 90 0] [0.5]]
		] :fontHeight
		jumpTo :center
	]

	setTurtleState :oldState
end

to drawD :fontHeight
	localmake "oldState turtleState
	localmake "arcRadius 0.435
	localmake "width1 0.18
	localmake "arc1 [[-90 0] [:width1] [-180 :arcRadius] [:width1]]
	setLineJoinStyle "miter
	setPenSize :fontHeight * 0.1
	jumpLeft :fontHeight * 0.3
	jumpForward :fontHeight * 0.06
	forward :arcRadius * 2 * :fontHeight
	arcLines :arc1 :fontHeight
	closePath
	setTurtleState :oldState
end

; Inspired by logo at:
; https://en.wikipedia.org/wiki/RAND_Corporation#/media/File:RAND_logo.svg
to randCorporationLogo :height
	localmake "oldState turtleState
	localmake "fontHeight :height * 0.21

	stripes :height :height ["#751ddb]
	drawUpperLeftArc :height

	setPenColor "white
	jumpForward :height * 0.138
	jumpLeft :height * 0.324
	drawR :fontHeight
	jumpRight :height * 0.193
	drawA :fontHeight
	jumpRight :height * 0.23
	drawN :fontHeight
	jumpRight :height * 0.247
	drawD :fontHeight
	setTurtleState :oldState
end

randCorporationLogo 100