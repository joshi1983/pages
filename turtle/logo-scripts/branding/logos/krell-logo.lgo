to drawK :height
	localmake "oldState turtleState
	localmake "radius1 0.14
	jumpLeft :height * 0.23
	stripes :height * 0.17 :height [penColor]
	jumpForward :height / 2
	right 90
	setFillColor penColor
	setPenSize 0
	repeat 2 [
		drawArcLineShape [-0.07 0
			[[90 0.36] [-30 :radius1] [-60 0] [0.19] [-120 0]
			[30 :radius1] [0.12] [-90 0.33] [0.3]]
		] :height * sign repcount - 1.5
	]

	setTurtleState :oldState
end

to drawR :height
	localmake "oldState turtleState
	jumpLeft :height * 0.26
	setLineCap "butt
	setLineJoinStyle "miter
	setPenSize :height * 0.18
	arcLines [[1 - penSize / 2 / :height] [-90 0] [0.31]
	[-180 0.21] [0.07] [90 0] [0.1] [90 0.3] [0.08]] :height

	setTurtleState :oldState
end

to drawE :height
	localmake "oldState turtleState
	localmake "width :height * 0.72
	localmake "thickness :height * 0.2
	localmake "width1 :width - :thickness / 2
	jumpRight :width / 2
	jumpForward :height / 2
	left 90
	stripes :thickness :height * 0.39 [penColor]
	setPenSize :thickness
	setLineCap "butt
	setLineJoinStyle "miter
	jumpLeft (:height - penSize) / 2
	forward :width1
	right 90
	forward :height - penSize
	right 90
	forward :width1

	setTurtleState :oldState
end

to drawL :height
	localmake "oldState turtleState
	localmake "oldPos pos
	localmake "oldHeading heading
	localmake "width :height * 0.72
	localmake "thickness :height * 0.2
	jumpForward :height
	localmake "top pos
	jumpRight :height
	localmake "topRight pos
	jumpTo :oldPos

	setPenSize :thickness
	jumpRight :width / 2
	jumpForward penSize / 2
	left 90
	setLineCap "butt
	setLineJoinStyle "miter
	localmake "lowerRight pos
	forward :width - penSize / 2
	right 90
	forward :height - penSize / 2
	jumpTo :lowerRight
	setHeading :oldHeading - 90
	jumpRight (:height - :thickness) / 2
	forward :height * 0.3
	right 90
	forward distanceToLine :top :topRight

	setTurtleState :oldState
end

; Inspired by logo at:
; https://archive.org/details/KrellsLogo4amCrack
; "logo" might be confusing here because both the 
; graphic and the programming language apply.
; 
; That is also a link to an emulated version of a 
; Logo programming environment made by Krell on Apple 2.
to krellLogo :height
	localmake "oldState turtleState
	jumpLeft :height * 1.15
	drawK :height
	jumpRight :height * 0.73
	drawR :height
	jumpRight :height * 0.76
	drawE :height
	jumpRight :height * 0.76
	drawL :height
	setTurtleState :oldState
end

krellLogo 100