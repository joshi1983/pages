to expo85Triangle :height
	localmake "oldState turtleState
	localmake "angle 30
	setFillColor "#113065
	setPenSize 0
	isoTriangle :height * 1.2 :height
	setFillColor "white
	jumpForward :height * 0.73
	circle :height * 0.07
	jumpBackward :height * 0.49
	jumpRight :height * 0.07
	right :angle
	setPenSize :height * 0.03
	setPenColor fillColor
	setFillColor transparent
	repeat 2 [
		ellipse :height * 0.4 :height * 0.08
		jumpForward :height * 0.09
	]
	setTurtleState :oldState
end

; Inspired by logo at:
; https://youtu.be/Fu8Z9UqGvYI?t=344
;
; A similar logo is shown at:
; https://www.logohistories.com/p/expo-85-logo-ikko-tanaka-japan-design
to expo85Logo :height
	localmake "oldState turtleState
	localmake "oldPos pos
	localmake "triangleHeight :height * 0.825
	jumpForward :height - :triangleHeight
	expo85Triangle :triangleHeight

	jumpTo :oldPos
	setPenSize 0
	setFillColor "white
	setFontSize :height * 0.17
	setFontFamily "arial
	jumpForward :height * 0.003
	jumpLeft :height * 0.35
	right 90
	label 'EXPO\'85'

	setTurtleState :oldState
end

setScreenColor "gray
expo85Logo 100