; Inspired by flag at:
; https://commons.wikimedia.org/wiki/Gallery_of_flags_with_triangles#/media/File:Flag_of_Abejorral.svg
to abejorralFlag :height
	localmake "oldState turtleState
	localmake "width :height * 2
	stripes :width :height ["#0a0 "#fe0]
	jumpForward :height / 2
	setFillColor "#d00
	jumpLeft :width / 2
	right 90
	setPenSize 0
	isoTriangle :height :height / 2
	
	setTurtleState :oldState
end

abejorralFlag 100